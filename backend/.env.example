# LeadBoost SaaS - Environment Variables

# Database
DATABASE_URL=your_postgresql_connection_string_here
# Celery & Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# API Keys
GROQ_API_KEY=your_groq_api_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Sender Information
# Fallback only -- outreach uses each organization's own name (set in its
# profile) first; this is used only for organizations that haven't set one.
SENDER_ORG=Your Company Name

# Email Account credential encryption (P1.3). Required to create/verify an
# organization's sender mailboxes (core/domain/models/email_account.py) --
# without it, those operations fail with a clear error rather than
# silently storing the credential in plaintext. Generate a real value with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never commit the real value. In production (Railway/Render/etc.), set
# this as a platform secret/variable, the same way SECRET_KEY is set --
# never in this file, never in source, never in the Alembic migration.
EMAIL_CREDENTIAL_ENCRYPTION_KEY=

# --- Mailer Agent integration (server-to-server; never exposed to the browser) ---
# Deployed Mailer API base URL. https:// only (http:// allowed for loopback hosts only).
MAILING_AGENT_BASE_URL=
# JSON object {"<leadboost_org_id>": "<mailer_api_key>"}, one key per LeadBoost organization.
# Inverse of the Mailer's ORG_KEY_MAP ({"<key>": "<org_id>"}). Secret: never commit a real value.
MAILING_AGENT_ORG_API_KEYS=
# MAILING_AGENT_TIMEOUT_SECONDS=15

# --- Prometheus /metrics: OWNER/OPERATOR ONLY ---
# GET /metrics exposes process-global telemetry across ALL organizations, so it requires this
# dedicated bearer token (Authorization: Bearer <token>). Leave it UNSET to disable the endpoint
# (it answers 403) -- the right setting when nothing scrapes it. If set it must be at least 32
# random characters and different from SECRET_KEY and every other secret here; otherwise the
# endpoint stays disabled (403) and a startup warning says why. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Platform secret / protected variable only: never commit it, never put it in a frontend
# (NEXT_PUBLIC_*/Vercel) variable, never pass it in a URL. The self-hosted Prometheus reads the
# same value from monitoring/secrets/metrics_bearer_token (see docs/MONITORING.md).
# METRICS_BEARER_TOKEN=

# --- Self-hosted monitoring stack (docker-compose.prod.yml only) ---
# Grafana is required to have a real admin password (compose refuses to start it otherwise).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# --- In-process background job loop (runs LEAD_PIPELINE jobs) ---
# Leave enabled on the single web service; defaults shown.
# JOB_WORKER_ENABLED=true
# JOB_WORKER_CONCURRENCY=3
# JOB_POLL_INTERVAL_SECONDS=2

# Frontend URL
FRONTEND_URL=http://localhost:5173

# AI feature gating by subscription plan (pre-existing; used by
# core/infrastructure/billing/subscription_service.py and honored by the
# Application layer's agents via the ai_features_enabled flag)
CAN_USE_AI_FREE=false
CAN_USE_AI_PRO=true
CAN_USE_AI_ENTERPRISE=true

# Application Layer (backend/application) - LangGraph AI workflow
LLM_MODEL=llama-3.3-70b-versatile
REVIEW_AUTO_APPROVE_THRESHOLD=0.75
REVIEW_HUMAN_REVIEW_THRESHOLD=0.45

# Scraper (backend/core/infrastructure/scraping/scraper.py) - hybrid tiers
SCRAPER_MAX_CONCURRENT_PAGES=4
RESPECT_ROBOTS_TXT=false

# Business Discovery Layer (backend/application/discovery)
# Primary business-search provider (OpenStreetMap). Default is the public
# Overpass instance; point this at a self-hosted mirror for higher volume.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
# Fallback website-resolution provider. Optional: if unset, Discovery
# simply won't resolve websites for businesses OSM has no website for
# (website stays null; the business is still reported, just unvalidated).
BRAVE_API_KEY= 

SERPER_API_KEY=your_serper_api_key_here

# How many businesses' LeadPipeline runs Discovery executes concurrently
# per search request.
DISCOVERY_MAX_CONCURRENT_PIPELINES=3
# How many candidates' website resolution/validation Discovery runs
# concurrently per search request (bounded worker pool -- see SECTION 3
# of the production-polish brief on keeping memory usage predictable).
DISCOVERY_MAX_CONCURRENT_RESOLUTIONS=5

# Plan limits (core/infrastructure/billing/subscription_service.py).
# Free/Pro/Enterprise daily lead limits and feature flags -- all optional,
# defaults shown below (all export flags default to false) are what's
# used if unset. Set CAN_EXPORT_PRO/CAN_EXPORT_ENTERPRISE=true once your
# export feature is ready for paid tiers.
FREE_MAX_LEADS_PER_DAY=50
PRO_MAX_LEADS_PER_DAY=500
ENTERPRISE_MAX_LEADS_PER_DAY=10000
CAN_EXPORT_FREE=false
CAN_EXPORT_PRO=false
CAN_EXPORT_ENTERPRISE=false
DEFAULT_PLAN=free